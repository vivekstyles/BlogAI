{
  "name": "blogai-directory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.js",
    "build:client": "vite build",
    "preview": "vite preview",
    "lint:csv": "python scripts/linter.py",
    "build:data": "python scripts/build_data.py",
    "validate:seo": "python scripts/validate_seo.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "npm run lint:csv && npm run build:data && npm test && npm run build && npm run validate:seo"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
