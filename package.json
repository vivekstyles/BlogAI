{
  "name": "blogai-directory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run_build_data.js && node scripts/build_articles.js && vite",
    "build": "node scripts/run_build_data.js && node scripts/build_articles.js && vite build && node scripts/prerender.js",
    "build:client": "vite build",
    "preview": "vite preview",
    "lint:csv": "python scripts/linter.py",
    "build:data": "node scripts/run_build_data.js",
    "build:articles": "node scripts/build_articles.js",
    "validate:seo": "python scripts/validate_seo.py",
    "check:live": "python scripts/check_live_seo.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "npm run lint:csv && npm run build:data && npm run build:articles && npm test && npm run build && npm run validate:seo"
  },
  "dependencies": {
    "katex": "^0.18.11",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "marked": "^18.1.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "yaml": "^2.9.1"
  }
}
